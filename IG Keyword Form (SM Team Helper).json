    {
      "parameters": {
        "jsCode": "// Duplicate check: same ig_account_id + same keyword (case-insensitive) + same media_id (blank = all posts), active rows\nconst row = $('Prepare Row').first().json;\nconst toBool = (v) => v === true || ['true', '1', 'yes', 'y'].includes(String(v ?? '').trim().toLowerCase());\nconst normKw = (s) => String(s ?? '').trim().replace(/\\s+/g, ' ').toUpperCase();\nconst cleanId = (s) => String(s ?? '').trim().replace(/^'+/, '').trim();\n\nconst dup = $input.all().map((i) => i.json).find((r) =>\n  r && r.keyword !== undefined && r.keyword !== null &&\n  String(r.ig_account_id ?? '').trim() === row.ig_account_id &&\n  toBool(r.is_active) &&\n  normKw(r.keyword) === normKw(row.keyword) &&\n  cleanId(r.media_id) === row.media_id\n);\n// Duplicate found => skip the insert (Form Duplicate page)\nreturn [{ json: { ...row, is_duplicate: Boolean(dup) } }];"
      },
      "id": "1cf5f278-3461-4671-b4fe-08cf1f27a6f8",
      "name": "Check Duplicate",
