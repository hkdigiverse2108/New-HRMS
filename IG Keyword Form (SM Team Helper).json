    {
      "parameters": {
        "jsCode": "// Match the shortcode across the media list pages (one page per item) and extract the media_id\nconst ctx = $('Validate & Parse').first().json;\nconst target = ctx.shortcode;\nlet found = null, scanned = 0;\nfor (const it of $input.all()) {\n  for (const m of (it.json.data || [])) {\n    scanned++;\n    if (m.shortcode === target || String(m.permalink || '').includes('/' + target + '/')) { found = m; break; }\n  }\n  if (found) break;\n}\nif (!found) {\n  return [{ json: { ok: false, error: 'Could not resolve media_id: this post was not found in the ' + scanned + ' most recent media items of @' + ctx.username + '. Check the link / account, or enter the media_id directly.' } }];\n}\n// Pass the context on (token included - Prepare Row strips it) + resolved media_id\nreturn [{ json: { ...ctx, media_id: String(found.id), media_source: 'link' } }];"
      },
