    {
      "parameters": {
        "jsCode": "// ============================================================\n// Validate & Parse\n// Input : IG_Accounts rows (Get IG Accounts) ; form data = $('SM Form')\n// Output: ok + account + media_id plan (form -> link -> blank)\n// ============================================================\nconst f = $('SM Form').first().json;\nconst clean = (v) => String(v ?? '').trim();\nconst toBool = (v) => v === true || ['true', '1', 'yes', 'y'].includes(String(v ?? '').trim().toLowerCase());\nconst fail = (error) => [{ json: { ok: false, error } }];\n\n// ---- 1) Account: username comes from the dropdown; everything else comes from IG_Accounts ----\nconst username = clean(f.username).replace(/^@/, '');\nif (!username) return fail('Please select an account (username).');\n\nconst rows = $input.all().map((i) => i.json).filter((r) => r && (r.username || r.ig_account_id));\nconst acc = rows.find((a) =>\n  String(a.username ?? '').replace(/^@/, '').trim().toLowerCase() === username.toLowerCase());\n\nif (!acc) return fail('Account not found in IG_Accounts: @' + username);\nif (!toBool(acc.is_active)) return fail('Account is inactive: @' + username + '. Set is_active = true in IG_Accounts first.');\nif (!clean(acc.ig_account_id)) return fail('ig_account_id is missing in IG_Accounts for @' + username + '.');\n\n// ig_account_id and access_token are NEVER taken from the form - only from IG_Accounts\nconst token = clean(acc.access_token);\nif (!token) return fail('access_token is missing in IG_Accounts for @' + username + '.');\n\nconst keyword = clean(f.keyword);\nconst message = clean(f.message);\nif (!keyword || !message) return fail('keyword and message are required.');\n\n// ---- 2) media_id priority: form media_id -> post_link (API) -> blank ----\nconst rawMedia = clean(f.media_id).replace(/^'+/, '').trim();   // strip leading apostrophe added by Sheets/Excel\nconst link = clean(f.post_link);\nconst looksValid = /^\\d{10,25}$/.test(rawMedia);                // Graph media IDs are numeric\n\nlet media_id = '', media_source = 'none', need_lookup = false, shortcode = '';\n\nif (rawMedia && looksValid) {\n  // (a) valid media_id in the form => use it directly, no API call\n  media_id = rawMedia; media_source = 'form';\n} else if (link) {\n  // (b) media_id blank (or invalid) + post_link => extract shortcode, resolve via API\n  // instagram.com/p/XXXX/ , /reel/XXXX/ , /reels/XXXX/ , /tv/XXXX/ , /<user>/reel/XXXX/\n  const m = link.match(/instagram\\.com\\/(?:[A-Za-z0-9_.]+\\/)?(?:p|reel|reels|tv)\\/([A-Za-z0-9_-]+)/i);\n  if (!m) return fail('Could not find a shortcode in the post link. Expected format: https://www.instagram.com/reel/XXXX/ or /p/XXXX/');\n  shortcode = m[1]; media_source = 'link'; need_lookup = true;\n} else if (rawMedia) {\n  // media_id was given but looks invalid and there is no link => do not silently turn it into \"all posts\"\n  return fail('media_id looks invalid (digits only, 10-25 characters). Enter a valid media_id or provide a post_link.');\n}\n// (c) both blank => media_id '' (all posts)\n\nconst rf = clean(f.require_follow).toLowerCase();\nreturn [{ json: {\n  ok: true,\n  ig_account_id: clean(acc.ig_account_id),\n  username: clean(acc.username).replace(/^@/, ''),\n  access_token: token,\n  keyword, message,\n  comment_reply1: clean(f.comment_reply1),\n  comment_reply2: clean(f.comment_reply2),\n  comment_reply3: clean(f.comment_reply3),\n  require_follow: rf === '' ? true : toBool(rf),     // default true\n  desc: clean(f.desc),                               // blank => ''\n  media_id, media_source, need_lookup, shortcode\n} }];"
      },
