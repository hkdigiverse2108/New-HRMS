    {
      "parameters": {
        "jsCode": "// Pick active accounts whose token refresh is due.\n// Due: updated_at missing/invalid OR age >= 50 days (Meta rule: token must be at least 24h old; 50 days is safe)\nconst DAYS = 50;\nconst now = Date.now();\nconst toBool = (v) => v === true || ['true', '1', 'yes', 'y'].includes(String(v ?? '').trim().toLowerCase());\n\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (!r || !r.ig_account_id) continue;\n  if (!toBool(r.is_active)) continue;\n  if (!String(r.access_token ?? '').trim()) continue;\n\n  const t = Date.parse(r.updated_at || '');\n  const ageDays = Number.isFinite(t) ? (now - t) / 86400000 : null;\n  if (ageDays !== null && ageDays < DAYS) continue;          // not due yet\n\n  out.push({ json: {\n    ig_account_id: String(r.ig_account_id).trim(),\n    username: String(r.username ?? ''),\n    access_token: String(r.access_token).trim(),\n    age_days: ageDays === null ? null : Math.floor(ageDays),\n    reason: ageDays === null ? 'updated_at missing' : 'age >= ' + DAYS + ' days'\n  } });\n}\nreturn out;   // empty => nothing runs downstream"
      },
      "id": "ab813c16-8439-4bcd-a91c-59ed8ff55220",
      "name": "Select Due Accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
