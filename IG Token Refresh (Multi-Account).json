      "id": "939bcf71-9931-495a-b9de-ebdc96cc5ce6",
      "name": "Get IG Accounts",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        -688,
        224
      ],
      "alwaysOutputData": true,
      "executeOnce": true
