      "id": "0f78972c-6e53-4e12-93c3-0cb61d63b46d",
      "name": "Refresh Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        224
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Refresh response -> update payload (the token is not repeated in logs/output beyond new_token)\nconst ctx = $('Select Due Accounts').item.json;\nconst newToken = String($json.access_token ?? '').trim();\nreturn { json: {\n  ig_account_id: ctx.ig_account_id,\n  username: ctx.username,\n  has_token: newToken !== '',\n  new_token: newToken,\n  updated_at: new Date().toISOString(),\n  expires_in: $json.expires_in ?? null,\n  error: newToken ? null : 'Refresh response did not contain an access_token'\n} };"
      },
