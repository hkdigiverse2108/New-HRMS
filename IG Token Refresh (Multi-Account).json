    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Refresh/update failed: only build a log item - the IG_Accounts row is never deleted or modified (token masked)\nlet ctx = {};\nfor (const nm of ['Build Update', 'Select Due Accounts']) {\n  try { const j = $(nm).item.json; if (j && j.ig_account_id) { ctx = j; break; } } catch (e) {}\n}\nconst e = $json.error;\nconst msg = typeof e === 'string' ? e : ((e && (e.message || e.description)) || JSON.stringify($json)).toString();\nlet hint = 'Check the error field.';\nif (/190|expired|invalid|session|oauth/i.test(msg)) hint = 'Token expired/invalid: generate a new long-lived token in Meta for Developers and paste it into IG_Accounts manually.';\nelse if (/24|hour|minimum|too (new|recent)/i.test(msg)) hint = 'Token must be at least 24 hours old - it will be retried next Monday.';\nelse if (/rate|limit|613|\\b4\\b/i.test(msg)) hint = 'Rate limit - it will be retried next Monday.';\nreturn { json: {\n  refresh_failed: true,\n  ig_account_id: $json.ig_account_id || ctx.ig_account_id || null,\n  username: $json.username || ctx.username || null,\n  error: msg.replace(/access_token=[^&\\s\"]+/gi, 'access_token=***').slice(0, 400),\n  hint,\n  failed_at: new Date().toISOString()\n} };"
      },
